# Copy to .env on the VM and replace every angle-bracket placeholder.
# Never commit or send the completed file through chat.
AUTH_MODE=app
DATAVERSE_URL=https://sbamanager.crm.dynamics.com
TENANT_ID=<dataverse-tenant-id>
CLIENT_ID=<dataverse-application-client-id>
CLIENT_SECRET=<dataverse-application-client-secret>
LOGIN_HINT=

ENTITY_SET=crmee_service_requests
COL_ID=crmee_service_requestid
COL_CASE_NUMBER=crmee_sr_number
COL_OWNER=_ownerid_value
COL_SLA_DUE=crmee_sla_expired_date,crmee_sr_initialresponse
COL_SLA_START=crmee_sla_start_date
COL_SLA_MET=crmee_sla_met
COL_STATUS_CODE=crmee_sr_status_code
COL_STATE=statecode
EXTRA_FILTER=statecode eq 0 and crmee_sr_status_code ne 'Closed'
SUPPORT_POD_CONTAINS=- Integration
COL_PRODUCT=_crmee_product_name_value
COL_COUNTRY=_crmee_sr_country_value
COL_SUPPORT_REGION=_crmee_support_region_value
COL_POD=_crmee_supportpod_value

WARN_MINUTES=60
REFRESH_SECONDS=60
HOST=127.0.0.1
PORT=8081
LOCAL_DB_PATH=C:\SlaMonitor\sla_cache.db
NOTIFICATION_RETENTION_DAYS=7
SYNC_WATERMARK_COLUMN=modifiedon
SYNC_OVERLAP_SECONDS=120
FULL_SYNC_EVERY_MINUTES=30
RULESETS_FILE=C:\SlaMonitor\rulesets.json

TEAMS_DESTINATION_NAME=Daily meet
TEAMS_NOTIFICATIONS_ENABLED=true
TEAMS_WEBHOOK_URL=<teams-workflow-webhook-url>
EMAIL_NOTIFICATIONS_ENABLED=false