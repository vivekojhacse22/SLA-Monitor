{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.22/MicrosoftTeams.schema.json",
  "manifestVersion": "1.22",
  "version": "1.0.0",
  "id": "${TEAMS_BOT_CLIENT_ID}",
  "developer": {
    "name": "SLA Monitor",
    "websiteUrl": "https://${FUNCTION_HOST_NAME}",
    "privacyUrl": "https://${FUNCTION_HOST_NAME}/privacy",
    "termsOfUseUrl": "https://${FUNCTION_HOST_NAME}/terms"
  },
  "name": {
    "short": "SLA Alerts",
    "full": "SLA Alert Notification"
  },
  "description": {
    "short": "Posts approaching SLA deadlines to a Teams channel.",
    "full": "Monitors pending Dataverse service requests and proactively posts each approaching SLA deadline once to the activated Teams channel thread."
  },
  "icons": {
    "outline": "outline.png",
    "color": "color.png"
  },
  "accentColor": "#C4314B",
  "bots": [
    {
      "botId": "${TEAMS_BOT_CLIENT_ID}",
      "scopes": ["team"],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "commandLists": [
        {
          "scopes": ["team"],
          "commands": [
            {
              "title": "activate alerts",
              "description": "Use this channel thread for SLA alerts"
            }
          ]
        }
      ]
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": ["${FUNCTION_HOST_NAME}"]
}