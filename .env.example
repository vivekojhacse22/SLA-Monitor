AUTH_MODE=device
DATAVERSE_URL=https://sbamanager.crm.dynamics.com
TENANT_ID=<tenant-id>
CLIENT_ID=<dataverse-client-id>
CLIENT_SECRET=
LOGIN_HINT=<user@example.com>
WARN_MINUTES=60
REFRESH_SECONDS=60
TEAMS_NOTIFICATIONS_ENABLED=false
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_TENANT_ID=<tenant-id>
EMAIL_CLIENT_ID=<mail-app-client-id>
EMAIL_CLIENT_SECRET=<mail-app-client-secret>
EMAIL_SENDER=viojha@microsoft.com
EMAIL_RECIPIENTS=viojha@microsoft.com
# --- Local DB (hot cache of cases pending SLA) ---------------------------
LOCAL_DB_PATH=sla_cache.db
NOTIFICATION_RETENTION_DAYS=7

# --- Incremental sync -----------------------------------------------------
SYNC_WATERMARK_COLUMN=modifiedon
SYNC_OVERLAP_SECONDS=120
FULL_SYNC_EVERY_MINUTES=30

# --- Business / ruleset fan-out ------------------------------------------
RULESETS_FILE=rulesets.json
